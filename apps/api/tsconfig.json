{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@masaar/scpp-rules": ["../../packages/scpp-rules/src/index.ts"],
      "@masaar/working-days": ["../../packages/working-days/src/index.ts"],
      "@masaar/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}

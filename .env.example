# Copy to .env (gitignored). Matches docker-compose.yml.
DATABASE_URL="postgresql://masaar:masaar_dev@localhost:5432/masaar?schema=public"

# API
API_PORT=4000
# Comma-separated allowed origins for CORS (the web app dev + preview servers)
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# Session — dev secret only. In production use a long random value from a secret store.
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_TTL="8h"

# Auth mode: "mock" issues local JWTs (dev); "azure" delegates to MSAL (prod, not wired yet)
AUTH_MODE="mock"

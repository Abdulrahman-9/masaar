{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@masaar/working-days": ["packages/working-days/src/index.ts"],
      "@masaar/scpp-rules": ["packages/scpp-rules/src/index.ts"],
      "@masaar/tokens": ["packages/tokens/src/index.ts"],
      "@masaar/ui": ["packages/ui/src/index.ts"]
    }
  }
}
